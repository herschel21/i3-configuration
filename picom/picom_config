backend = "glx";
vsync = true;
glx-use-copysubbuffer-mesa = true;
glx-copy-from-front = true;
glx-swap-method = 2;
xrender-sync = true;
xrender-sync-fence = true;

# Opacity rules for GNOME Terminal (active vs inactive)
# Apply 90% opacity for active GNOME Terminal
opacity-rule = [
    "90:class_g = 'Gnome-terminal' && focused",  # Active GNOME Terminal
    "85:class_g = 'Gnome-terminal' && !focused"  # Inactive GNOME Terminal
];

# Global opacity settings for non-GNOME-Terminal windows
inactive-opacity = 1.0  # Full opacity for inactive windows
active-opacity = 1.0    # Full opacity for active windows

# Ensure active and inactive windows override global settings
inactive-opacity-override = true
active-opacity-override = true

# Enable fading for smoother transition
fading = true
fade-in-step = 0.04
fade-out-step = 0.04

# Optional: Aesthetic features
corner-radius = 10  # Rounded corners for windows
blur-background = false  # Disable background blur (for performance)

# Ensure no fading on open/close events
no_fading_openclose = true

focus-delay = 200

opacity-rule-Debug = true
